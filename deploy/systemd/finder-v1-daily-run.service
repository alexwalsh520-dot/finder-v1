[Unit]
Description=Finder V1 daily lead generation run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=finder
WorkingDirectory=/opt/finder-v1
Environment=PYTHONPYCACHEPREFIX=/opt/finder-v1/.pycache
EnvironmentFile=/etc/finder-v1.env
ExecStart=/opt/finder-v1/.venv/bin/python -m finder_v1.main daily-run --target-emails 150 --seed-batch-size 12 --max-cycles 25 --hard-stop-hour-local 22
